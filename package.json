{
  "name": "todo4me",
  "productName": "Todo4Me",
  "version": "2.2.0",
  "description": "Personal productivity dashboard: tasks, priorities, weekly planner, weekly notes and a document editor.",
  "author": "Todo4Me",
  "license": "MIT",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "node scripts/start.js",
    "dev": "node scripts/start.js --dev",
    "pack": "node scripts/build.js dir",
    "build": "node scripts/build.js nsis portable",
    "build:installer": "node scripts/build.js nsis",
    "build:portable": "node scripts/build.js portable",
    "release": "node scripts/build.js nsis portable --publish",
    "vendor": "node scripts/vendor.js"
  },
  "build": {
    "appId": "com.todo4me.app",
    "productName": "Todo4Me",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "index.html",
      "css/**",
      "js/**",
      "assets/**",
      "vendor/**",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "muelgerhbf",
        "repo": "todo4me",
        "releaseType": "draft"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Todo4Me",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Todo4Me-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Todo4Me-${version}-portable.exe"
    }
  },
  "devDependencies": {
    "@fontsource/carlito": "^5.2.7",
    "@fontsource/fira-code": "^5.2.7",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "katex": "^0.16.25",
    "prismjs": "^1.30.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
