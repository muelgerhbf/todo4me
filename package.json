{
  "name": "todo4me",
  "productName": "Todo4Me",
  "version": "2.6.0",
  "description": "Personal productivity dashboard: tasks, priorities, weekly planner, weekly notes and a document editor.",
  "author": {
    "name": "Todo4Me",
    "email": "muelgerhbf@users.noreply.github.com"
  },
  "homepage": "https://github.com/muelgerhbf/todo4me",
  "license": "MIT",
  "private": true,
  "main": "electron/main.js",
  "desktopName": "todo4me.desktop",
  "scripts": {
    "start": "node scripts/start.js",
    "dev": "node scripts/start.js --dev",
    "pack": "node scripts/build.js dir",
    "build": "node scripts/build.js nsis portable",
    "build:installer": "node scripts/build.js nsis",
    "build:portable": "node scripts/build.js portable",
    "release": "node scripts/build.js nsis portable --publish",
    "vendor": "node scripts/vendor.js",
    "build:linux": "node scripts/build.js linux",
    "build:appimage": "node scripts/build.js appimage",
    "build:deb": "node scripts/build.js deb",
    "build:rpm": "node scripts/build.js rpm",
    "release:linux": "node scripts/build.js linux --publish"
  },
  "build": {
    "appId": "com.todo4me.app",
    "productName": "Todo4Me",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "index.html",
      "css/**",
      "js/**",
      "assets/**",
      "vendor/**",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "muelgerhbf",
        "repo": "todo4me",
        "releaseType": "draft",
        "tagNamePrefix": "v"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Todo4Me",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Todo4Me-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Todo4Me-${version}-portable.exe"
    },
    "linux": {
      "icon": "build/icons",
      "category": "Office;ProjectManagement;",
      "synopsis": "Personal productivity dashboard: tasks, planner, notes and documents",
      "executableName": "todo4me",
      "maintainer": "Todo4Me <muelgerhbf@users.noreply.github.com>",
      "artifactName": "Todo4Me-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "syncDesktopName": true,
      "description": "Tasks, weekly planner, notes and documents"
    },
    "deb": {
      "depends": [
        "libgtk-3-0t64 | libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0t64 | libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2t64 | libasound2"
      ]
    }
  },
  "devDependencies": {
    "@fontsource/carlito": "^5.2.7",
    "@fontsource/fira-code": "^5.2.7",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "katex": "^0.16.25",
    "prismjs": "^1.30.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
